# Razorpay Payment Gateway (required for real checkout)
# Set this to your deployed Render API base URL ending in /api.
# Example: https://your-payment-service.onrender.com/api
# Never place Razorpay secrets in frontend/Vite variables.

# Frontend Configuration
VITE_API_URL=

# Firebase Configuration (Optional)
VITE_FIREBASE_ADMIN_EMAILS=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DB_ROOT=bookstore
