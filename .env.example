# Copy this file to .env.local and fill values from Firebase Console > Project settings > General > Your apps.
VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
# Comma-separated exact admin email addresses. Must match firebase-rules.json too.
VITE_FIREBASE_ADMIN_EMAILS=you@example.com

# Deployed Cloud Function base URL for printable purchases/downloads (no trailing slash).
VITE_API_URL=https://us-central1-your-project-id.cloudfunctions.net/api
