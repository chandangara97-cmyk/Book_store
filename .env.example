# ---- Storefront (Vite) : set on Render Static Site, or in .env.local for local dev ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_ADMIN_EMAILS=
VITE_API_URL=https://YOUR-API.onrender.com/api

# ---- Payment API (server/server.cjs) : set on Render Web Service, or in .env for local dev ----
NODE_VERSION=20
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
ADMIN_EMAILS=
# Render: /etc/secrets/service-account.json (Secret File). Local: service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/service-account.json
