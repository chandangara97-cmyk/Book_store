{
  "rules": {
    "bookstore": {
      "books": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'chandanpanwar001@gmail.com'"
      },
      "toys": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'chandanpanwar001@gmail.com'"
      },
      "learningPrivate": {
        ".read": "auth != null && auth.token.email === 'chandanpanwar001@gmail.com'",
        ".write": "auth != null && auth.token.email === 'chandanpanwar001@gmail.com'"
      },
      "learningResources": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'chandanpanwar001@gmail.com'"
      },
      "entitlements": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "printableOrders": {
        ".read": "auth != null && auth.token.email === 'chandanpanwar001@gmail.com'",
        ".write": false
      },
      "downloadTokens": {
        ".read": false,
        ".write": false
      },
      "orders": {
        ".read": "auth != null && auth.token.email === 'chandanpanwar001@gmail.com'",
        ".indexOn": [
          "razorpayOrderId"
        ],
        ".write": false
      },
      "users": {
        ".read": "auth != null && auth.token.email === 'chandanpanwar001@gmail.com'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}