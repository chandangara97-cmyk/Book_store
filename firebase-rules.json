{
  "rules": {
    "books": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && auth.token.email === 'REPLACE-WITH-ADMIN-EMAIL@example.com'"
    },
    "toys": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && auth.token.email === 'REPLACE-WITH-ADMIN-EMAIL@example.com'"
    },
    "orders": {
      "$orderId": {
        ".read": "auth != null && auth.token.email === 'REPLACE-WITH-ADMIN-EMAIL@example.com'",
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
